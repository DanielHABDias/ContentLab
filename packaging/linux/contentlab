#!/bin/sh
# Launcher do Content Lab instalado: usa o Node embutido, guarda dados fora do app e abre o navegador.
set -eu
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
NODE="$HERE/runtime/node"
export CONTENTLAB_INSTALLED=1
export CONTENTLAB_APP_DIR="${CONTENTLAB_APP_DIR:-$(dirname "$(dirname "$HERE")")}"
case "${1:-}" in
  --uninstall|--update|--rollback|--status|--install-archive) exec "$NODE" "$HERE/app/scripts/contentlab-installer.mjs" "$@" ;;
  --version) exec "$NODE" -p "require('$HERE/app/package.json').version" ;;
esac
PORT="${CONTENTLAB_PORT:-4173}"
URL="http://127.0.0.1:$PORT/"
open_browser() { xdg-open "$URL" >/dev/null 2>&1 || echo "Abra $URL no navegador."; }
if "$NODE" -e "fetch('${URL}api/v1/health').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"; then open_browser; exit 0; fi
if [ "${1:-}" != "--no-browser" ]; then ( sleep 1.5; open_browser ) & fi
exec "$NODE" "$HERE/app/src/server/http-server.js"
