{
  "name": "content-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "serve": "node src/server/http-server.js",
    "start": "npm run build && npm run serve",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "contentlab": "node src/adapters/cli.js",
    "mcp": "node src/adapters/mcp-server.js",
    "doctor": "node scripts/bootstrap.mjs --check",
    "prepare:local": "node scripts/bootstrap.mjs --prepare"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "jsdom": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
