{
  "name": "content-lab",
  "version": "2.1.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "serve": "node src/server/http-server.js",
    "start": "npm run build && npm run serve",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "contentlab": "node src/adapters/cli.js",
    "mcp": "node src/adapters/mcp-server.js",
    "doctor": "node scripts/bootstrap.mjs --check",
    "prepare:local": "node scripts/bootstrap.mjs --prepare",
    "qa:e2e": "node scripts/qa-e2e.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "app": "node scripts/start.mjs",
    "app:stop": "node scripts/start.mjs stop",
    "app:status": "node scripts/start.mjs status",
    "qa:hq": "node scripts/qa-hq.mjs",
    "qa:mcp": "node scripts/qa-mcp.mjs",
    "scenes:diazverso": "node scripts/build-diazverso-scenes.mjs",
    "qa:motion": "node scripts/qa-motion.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "4.0.543",
    "typescript": "^5.9.3",
    "vite": "latest",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
