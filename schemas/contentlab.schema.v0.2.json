{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentlab.local/schema/v0.2",
  "title": "Content Lab Edit Plan v0.2 — motion design",
  "type": "object",
  "required": ["version", "project", "audio", "timeline"],
  "properties": {
    "version": {"const": "0.2"},
    "project": {
      "type": "object",
      "required": ["name", "format", "profile"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "format": {"enum": ["youtube_long", "youtube_short", "custom"]},
        "profile": {"type": "string", "minLength": 1},
        "resolution": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "seed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "sources": {"type": "object", "properties": {"assets": {"type": "string"}, "transcript": {"type": "string"}, "assetCatalog": {"type": "string"}}, "additionalProperties": false},
    "audio": {
      "type": "object",
      "required": ["narration"],
      "properties": {
        "narration": {"type": "string", "minLength": 1},
        "sourceCuts": {"type": "array", "items": {"$ref": "#/$defs/timeRange"}},
        "voice": {"type": "object", "properties": {"preset": {"type": "string"}, "trimDb": {"type": "number"}, "normalize": {"type": "boolean"}, "targetLufs": {"type": "number", "minimum": -30, "maximum": -5}, "truePeakDb": {"type": "number", "minimum": -9, "maximum": 0}, "highpassHz": {"type": "number", "minimum": 0, "maximum": 300}}, "additionalProperties": false},
        "ducking": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "ratio": {"type": "number", "minimum": 1, "maximum": 20}, "attackMs": {"type": "number", "minimum": 0.1, "maximum": 2000}, "releaseMs": {"type": "number", "minimum": 1, "maximum": 9000}}, "additionalProperties": false},
        "music": {
          "type": "array",
          "items": {
            "type": "object", "required": ["asset", "start", "end"],
            "properties": {"asset": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "preset": {"type": "string"}, "trimDb": {"type": "number"}, "fadeIn": {"type": "number", "minimum": 0}, "fadeOut": {"type": "number", "minimum": 0}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/scene"}}
  },
  "additionalProperties": false,
  "$defs": {
    "timeRange": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
    "box": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"preset": {"type": "string"}, "padding": {"type": "number", "minimum": 0}, "radius": {"type": "number", "minimum": 0}, "shadow": {"type": "string"}, "background": {"type": "string"}, "border": {"type": "string"}}, "additionalProperties": false}]},
    "animation": {"type": "object", "properties": {"enter": {"type": "string"}, "idle": {"type": "string"}, "exit": {"type": "string"}, "enterDuration": {"type": "number", "exclusiveMinimum": 0}, "exitDuration": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
    "reveal": {"type": "object", "required": ["charactersPerSecond"], "properties": {"charactersPerSecond": {"type": "number", "exclusiveMinimum": 0}, "delay": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "textStyle": {"type": "object", "properties": {"fontFamily": {"enum": ["Anton", "Bangers"]}, "uppercase": {"type": "boolean"}, "color": {"type": "string"}, "outlineColor": {"type": "string"}, "outlineWidth": {"type": "number", "minimum": 0, "maximum": 40}, "shadow": {"type": "object", "properties": {"color": {"type": "string"}, "blur": {"type": "number", "minimum": 0, "maximum": 100}, "offsetX": {"type": "number", "minimum": -100, "maximum": 100}, "offsetY": {"type": "number", "minimum": -100, "maximum": 100}}, "additionalProperties": false}}, "additionalProperties": false},
    "cameraShake": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "amplitude": {"type": "number", "minimum": 0, "maximum": 0.03}, "frequency": {"type": "number", "exclusiveMinimum": 0, "maximum": 20}}, "additionalProperties": false},
    "transform": {"type": "object", "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 8}, "rotation": {"type": "number", "minimum": -360, "maximum": 360}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "keyframe": {"type": "object", "required": ["t"], "properties": {"t": {"type": "number", "minimum": 0}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 8}, "rotation": {"type": "number", "minimum": -360, "maximum": 360}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}, "easing": {"enum": ["linear", "ease_in", "ease_out", "ease_in_out"]}}, "additionalProperties": false},
    "cameraKeyframe": {"type": "object", "required": ["t"], "properties": {"t": {"type": "number", "minimum": 0}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "minimum": 1, "maximum": 4}, "easing": {"enum": ["linear", "ease_in", "ease_out", "ease_in_out"]}}, "additionalProperties": false},
    "element": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["video", "image", "text", "kinetic_text", "caption", "overlay", "sfx"]},
        "asset": {"type": "string"}, "text": {"type": "string"}, "style": {"type": "string"}, "fontAsset": {"type": "string"}, "fontScale": {"type": "number", "exclusiveMinimum": 0, "maximum": 3}, "reveal": {"$ref": "#/$defs/reveal"}, "textStyle": {"$ref": "#/$defs/textStyle"},
        "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "at": {"type": "number", "minimum": 0},
        "cells": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 9}, "minItems": 1, "uniqueItems": true},
        "fit": {"enum": ["cover", "contain", "stretch", "smart_cover"]},
        "box": {"$ref": "#/$defs/box"}, "animation": {"$ref": "#/$defs/animation"}, "z": {"type": "integer"}, "loop": {"type": "boolean"}, "muted": {"type": "boolean"}, "preset": {"enum": ["subtle", "normal", "strong"]}, "trimDb": {"type": "number"}, "fadeIn": {"type": "number", "minimum": 0}, "fadeOut": {"type": "number", "minimum": 0}, "sync": {"type": "string"},
        "emphasis": {"type": "array", "items": {"type": "string"}}, "range": {"$ref": "#/$defs/timeRange"}, "config": {"type": "object"},
        "id": {"type": "string", "minLength": 1}, "transform": {"$ref": "#/$defs/transform"}, "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}}
      },
      "additionalProperties": false
    },
    "background": {"type": "object", "properties": {"color": {"type": "string"}, "asset": {"type": "string"}, "fit": {"enum": ["cover", "contain", "stretch"]}, "loop": {"type": "boolean"}, "muted": {"type": "boolean"}, "preset": {"enum": ["subtle", "normal", "strong"]}, "trimDb": {"type": "number"}, "fadeIn": {"type": "number", "minimum": 0}, "fadeOut": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "layout": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"grid": {"const": "3x3"}, "preset": {"type": "string"}}, "additionalProperties": false}]},
    "scene": {
      "type": "object", "required": ["id", "start", "end", "elements"],
      "properties": {"id": {"type": "string", "minLength": 1}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "background": {"$ref": "#/$defs/background"}, "layout": {"$ref": "#/$defs/layout"}, "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}, "transitionOut": {"type": "string"}, "transitionDuration": {"type": "number", "exclusiveMinimum": 0}, "camera": {"type": "object", "properties": {"keyframes": {"type": "array", "items": {"$ref": "#/$defs/cameraKeyframe"}}, "shake": {"type": "array", "items": {"$ref": "#/$defs/cameraShake"}}}, "additionalProperties": false}},
      "additionalProperties": false
    }
  }
}
